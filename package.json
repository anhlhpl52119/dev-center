{
  "name": "stove-developer-center",
  "version": "1.0.10",
  "private": true,
  "type": "module",
  "engines": {
    "node": "~16.20.2"
  },
  "scripts": {
    "serve": "cross-env RUN_TYPE=dev nuxt dev",
    "serve:dev": "cross-env RUN_TYPE=dev nuxt dev",
    "serve:dev2": "cross-env RUN_TYPE=dev2 nuxt dev",
    "serve:qa": "cross-env RUN_TYPE=qa nuxt dev",
    "serve:qa2": "cross-env RUN_TYPE=qa2 nuxt dev",
    "serve:sandbox": "cross-env RUN_TYPE=sandbox nuxt dev",
    "serve:live": "cross-env RUN_TYPE=live nuxt dev",
    "build": "cross-env RUN_TYPE=dev nuxt build",
    "build:dev": "cross-env RUN_TYPE=dev nuxt build",
    "build:dev2": "cross-env RUN_TYPE=dev2 nuxt build",
    "build:qa": "cross-env RUN_TYPE=qa nuxt build",
    "build:qa2": "cross-env RUN_TYPE=qa2 nuxt build",
    "build:sandbox": "cross-env RUN_TYPE=sandbox nuxt build",
    "build:live": "cross-env RUN_TYPE=live nuxt build",
    "preview": "nuxt preview",
    "preview:dev": "cross-env RUN_TYPE=dev nuxt preview",
    "preview:qa": "cross-env RUN_TYPE=qa nuxt preview",
    "preview:sandbox": "cross-env RUN_TYPE=sandbox nuxt preview",
    "preview:live": "cross-env RUN_TYPE=live nuxt preview",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "prepare": "npx husky install",
    "betterer": "betterer --config ./.betterer.cjs",
    "commitlint": "commitlint",
    "lint": "eslint --ext \".ts,.vue\" --ignore-path .gitignore .",
    "lint:prettier": "prettier --check .",
    "prettier:fix": "prettier --write --list-different .",
    "lint:fix": "eslint --ext \".ts,.vue\" --ignore-path .gitignore . --fix",
    "cleancommit": "npm run prettier:fix && npm run lint:fix"
  },
  "lint-staged": {
    "**/*.{ts,vue}": [
      "npm run betterer precommit"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "dependencies": {
    "@mdi/font": "^7.3.67",
    "@nuxt/image": "^1.1.0",
    "@nuxtjs/i18n": "^9.0.0",
    "@pinia/nuxt": "^0.4.11",
    "@vavt/util": "^1.4.0",
    "cash-dom": "^8.1.5",
    "codemirror": "^6.0.1",
    "copy-to-clipboard": "^3.3.3",
    "floating-vue": "^5.2.2",
    "html-entities": "^2.4.0",
    "isomorphic-dompurify": "^2.4.0",
    "lodash.debounce": "^4.0.8",
    "luxon": "^3.5.0",
    "markdown-it": "^14.0.0",
    "markdown-it-anchor": "^8.6.7",
    "markdown-it-attrs": "^4.1.6",
    "markdown-it-container": "^4.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-image-figures": "^2.1.1",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-mark": "^3.0.1",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-plantuml": "^1.4.1",
    "markdown-it-replace-link": "^1.2.2",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-textual-uml": "^0.16.0",
    "markdown-it-toc-done-right": "^4.2.0",
    "mermaid": "^10.7.0",
    "nuxt-healthz": "^1.3.1",
    "pako": "^2.1.0",
    "pinia": "^2.1.4",
    "sanitize-html": "^2.11.0",
    "seed-core": "git+https://git.sginfra.net/seed-v3/seed-core.git#0.3.1-change-api-get-member",
    "swiper": "^10.3.1",
    "twemoji": "^14.0.2",
    "vee-validate": "^4.11.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.38.6",
    "@betterer/cli": "^5.4.0",
    "@betterer/typescript": "^5.4.0",
    "@commitlint/cli": "^17.6.5",
    "@nuxt/devtools": "latest",
    "@nuxtjs/device": "^3.1.0",
    "@nuxtjs/eslint-config-typescript": "^12.0.0",
    "@types/luxon": "^3.4.2",
    "@types/markdown-it": "^13.0.6",
    "@types/markdown-it-attrs": "^4.1.3",
    "@types/markdown-it-container": "^2.0.9",
    "@types/markdown-it-footnote": "^3.0.3",
    "@types/markdown-it-link-attributes": "^3.0.4",
    "@types/markdown-it-plantuml": "^1.4.4",
    "@types/node": "^16",
    "@types/pako": "^2.0.3",
    "@types/prettier": "^2.7.3",
    "@typescript-eslint/eslint-plugin": "^5.61.0",
    "@typescript-eslint/parser": "^5.60.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-vue": "^9.15.1",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.2",
    "nuxt": "^3.5.3",
    "nuxt-lodash": "^2.4.1",
    "nuxt-simple-robots": "^3.1.5",
    "nuxt-simple-sitemap": "^3.3.4",
    "prettier": "^2.8.8",
    "sass": "^1.69.3",
    "typescript": "^5.2.2",
    "vue-tsc": "^1.8.22"
  }
}
