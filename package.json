{
  "name": "development-center-vulcanus",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.14.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt cleanup && nuxt dev --dotenv .env",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "preview:host": "cross-env NITRO_HOST=local.onstove.com NITRO_PORT=3000 nuxt preview",
    "postinstall": "nuxt prepare",
    "build:dev": "cross-env RUN_TYPE=dev nuxt build",
    "build:dev2": "cross-env RUN_TYPE=dev2 nuxt build",
    "build:qa": "cross-env RUN_TYPE=qa nuxt build",
    "build:qa2": "cross-env RUN_TYPE=qa2 nuxt build",
    "build:sandbox": "cross-env RUN_TYPE=sandbox nuxt build",
    "build:live": "cross-env RUN_TYPE=live nuxt build",
    "lint:fix": "prettier --write . && eslint --fix",
    "gql:codegen": "npx graphql-codegen"
  },
  "dependencies": {
    "@shikijs/langs": "3.20.0",
    "@shikijs/themes": "3.20.0",
    "@sindresorhus/slugify": "3.0.0",
    "@vueuse/core": "14.1.0",
    "dayjs": "1.11.19",
    "dompurify": "3.3.1",
    "floating-vue": "5.2.2",
    "markdown-it": "14.1.0",
    "shiki": "3.20.0",
    "vue": "3.5.22",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "5.0.0",
    "@graphql-codegen/cli": "6.1.0",
    "@graphql-codegen/typescript": "5.0.6",
    "@graphql-codegen/typescript-generic-sdk": "4.0.2",
    "@graphql-codegen/typescript-operations": "5.0.6",
    "@iconify-json/solar": "1.2.5",
    "@iconify/tailwind4": "1.2.0",
    "@mdit/plugin-alert": "0.22.3",
    "@mdit/plugin-demo": "0.22.3",
    "@mdit/plugin-tasklist": "0.22.2",
    "@nuxt/icon": "2.1.0",
    "@nuxtjs/i18n": "10.0.6",
    "@shikijs/markdown-it": "3.19.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/dompurify": "3.0.5",
    "@types/markdown-it": "14.1.2",
